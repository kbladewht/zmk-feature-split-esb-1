menuconfig ZMK_SPLIT_ESB
    bool "ZMK ESB split transport"
    depends on ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL
    select ESB
    help
      Central-side Enhanced ShockBurst (2.4 GHz) split transport for one or more
      peripherals. One ESB packet carries one complete split message.
      ESB hardware ACK, retransmit and CRC provide reliability.

if ZMK_SPLIT_ESB

config ZMK_SPLIT_ESB_MAX_PAYLOAD
    int "Max on-air payload bytes"
    default 48
    help
      Must be >= the largest split message struct. A build assert checks this.

config ZMK_SPLIT_ESB_RX_QUEUE_SIZE
    int "Received-packet ring depth (power of 2)"
    default 16
    help
      Lock-free SPSC ring between the radio ISR and the dispatch thread. Must be
      a power of 2. Deep enough to ride out dispatch stalls at the RX rate.

config ZMK_SPLIT_ESB_EVENT_QUEUE_SIZE
    int "Central: behavior-bound event queue depth"
    default 16
    help
      Key, sensor and battery events queue here for the system workqueue,
      where ZMK behavior state lives. Input events bypass this queue.

config ZMK_SPLIT_ESB_PRIORITY
    int "Split transport registration priority"
    default 50

config ZMK_SPLIT_ESB_BATTERY_LOG
    bool "Log peripheral battery changes on the central"
    help
      Battery level changes to the central log, one line per percent step.
      Diagnostic only, needs a log backend.

config ZMK_SPLIT_ESB_HID_RELAY
    bool "Relay HID reports across the ESB link"
    help
      Central snoops HID reports and sends each one to relay-role peripherals.

config ZMK_SPLIT_ESB_HID_RELAY_POLL_MS
    int "Relay peripheral poll period, ms"
    default 4
    depends on ZMK_SPLIT_ESB_HID_RELAY
    help
      Poll period used by relay peripherals. Keep this in sync with their firmware.

config ZMK_SPLIT_ESB_HID_RELAY_KEEPALIVE_MS
    int "HID relay keepalive period, ms"
    default 4
    depends on ZMK_SPLIT_ESB_HID_RELAY
    help
      Central re-sends the current HID report at this rate while the relay queue
      is idle, so a rare dropped release report heals within one period.
      Match this to ZMK_SPLIT_ESB_HID_RELAY_POLL_MS so every relay poll has a fresh report.

menuconfig ZMK_SPLIT_ESB_WIRE
    bool "Wire link between split peripherals"
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    select RING_BUFFER
    select CRC
    help
      UART link between the central and a split peripheral. Reuses the ESB
      wire packet format above raw framing, with full duplex or simplex mode.

config ZMK_SPLIT_ESB_WIRE_PEER
    bool "Central has a wire peer"
    depends on ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_SPLIT_ESB_WIRE
    help
      Central ingests events and keepalives from split peripheral over wire
      link. Peer pipe named by chosen zmk,esb-wire-peer.

if ZMK_SPLIT_ESB_WIRE

config ZMK_SPLIT_ESB_WIRE_KEEPALIVE_MS
    int "Wire link keepalive period, ms"
    default 100

config ZMK_SPLIT_ESB_WIRE_TIMEOUT_MS
    int "Wire link peer-alive timeout, ms"
    default 500

endif # ZMK_SPLIT_ESB_WIRE

module = ZMK_SPLIT_ESB
module-str = ZMK ESB split transport
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_SPLIT_ESB
